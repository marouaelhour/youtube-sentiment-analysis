{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analyzer",
  "version": "1.1",
  "description": "Analyse des sentiments des commentaires YouTube avec Machine Learning.",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyse de sentiment"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}